# Supabase cloud Postgres connection string.
# Prefer the direct/transaction-pooler URL from Supabase project settings.
# In Docker Compose this is consumed by the local dbpool sidecar as the upstream URL.
ZERO_DATABASE_URL="postgres://postgres:password@db.project-ref.supabase.co:5432/postgres?sslmode=require"
# Optional client URL used by app containers. Leave empty to use the local PgBouncer sidecar.
ZERO_DATABASE_POOL_URL=""
# Optional control-plane DB URL for the API. Defaults to ZERO_DATABASE_URL so API/dashboard calls
# do not have to compete with worker traffic through the local dbpool.
ZERO_API_DATABASE_URL=""
ZERO_API_DATABASE_MAX_CONNS=2
ZERO_DBPOOL_DEFAULT_POOL_SIZE=8
ZERO_DBPOOL_RESERVE_POOL_SIZE=2
ZERO_DBPOOL_MAX_CLIENT_CONN=500
ZERO_AUTO_MIGRATE=true
ZERO_DATABASE_MAX_CONNS=1
ZERO_DATABASE_RETRIES=6
ZERO_DATABASE_RETRY_WAIT="5s"
ZERO_SUPABASE_URL="https://project-ref.supabase.co"
ZERO_SUPABASE_ANON_KEY=""
ZERO_SUPABASE_SERVICE_ROLE_KEY=""

# HackerOne API credentials used by the bbscope poller.
ZERO_H1_USERNAME=""
ZERO_H1_TOKEN=""

# Optional additional bbscope providers.
ZERO_BUGCROWD_TOKEN=""
ZERO_BUGCROWD_EMAIL=""
ZERO_BUGCROWD_PASSWORD=""
ZERO_BUGCROWD_OTP_SECRET=""
ZERO_BUGCROWD_PROXY=""
ZERO_BUGCROWD_PUBLIC_ONLY=true
ZERO_INTIGRITI_TOKEN=""

# Scope sync filters.
ZERO_SCOPE_PROVIDERS="h1"
ZERO_SCOPE_SYNC_MAX_AGE="24h"
ZERO_SCOPE_BOUNTY_ONLY=true
ZERO_SCOPE_PRIVATE_ONLY=false
ZERO_SCOPE_CATEGORIES="url,wildcard"

# External tools. The Docker image provides these binaries in PATH.
ZERO_TOOL_TIMEOUT="20m"
ZERO_SUBFINDER_BIN="subfinder"
ZERO_SUBFINDER_PROVIDER_CONFIG="/home/zero/.config/subfinder/provider-config.yaml"
ZERO_SUBFINDER_SOURCES="shodan,bevigil,virustotal,securitytrails"
ZERO_SUBFINDER_RATE_LIMITS="shodan=1/s,virustotal=4/m,securitytrails=1/s,bevigil=1/s"
ZERO_SUBFINDER_SHODAN_API_KEY=""
ZERO_SUBFINDER_BEVIGIL_API_KEY=""
ZERO_SUBFINDER_VIRUSTOTAL_API_KEY=""
ZERO_SUBFINDER_SECURITYTRAILS_API_KEY=""
ZERO_DNSX_BIN="dnsx"
ZERO_DNSX_RESOLVERS=""
ZERO_DNSX_RATE=200
ZERO_DNSX_BATCH_SIZE=1000
ZERO_DNSX_BATCH_TIMEOUT="10m"
ZERO_HTTPX_BIN="httpx"
ZERO_HTTPX_TIMEOUT=4
ZERO_HTTPX_THREADS=20
ZERO_HTTPX_BATCH_SIZE=50
ZERO_HTTPX_BATCH_TIMEOUT="5m"
ZERO_HTTPX_PATTERN_MIN_GROUP=200
ZERO_HTTPX_PATTERN_CAP=120
ZERO_HTTPX_PATTERN_FAMILY_CAP=12
ZERO_HTTPX_TLS_PROBE=false
ZERO_WEBANALYZE_BIN="webanalyze"
ZERO_WEBANALYZE_APPS="/usr/local/share/webanalyze/technologies.json"
ZERO_WEBANALYZE_WORKERS=4
ZERO_WEBANALYZE_CRAWL=0
ZERO_WEBANALYZE_FINGERPRINT_CAP=8
ZERO_WEBANALYZE_BATCH_SIZE=50
ZERO_WEBANALYZE_BATCH_TIMEOUT="10m"
ZERO_NUCLEI_BIN="nuclei"
ZERO_NUCLEI_TEMPLATE_DIR="/home/zero/nuclei-templates"
ZERO_NUCLEI_UPDATE_TEMPLATES_ON_STARTUP=true

# Conservative active validation defaults. Only medium/high/critical CVE templates
# should run by default; keep rate limits moderate to avoid noisy scans.
ZERO_NUCLEI_SEVERITIES="medium,high,critical"
ZERO_NUCLEI_TAGS="cve"
ZERO_NUCLEI_TEMPLATE_IDS=""
ZERO_NUCLEI_FROM_CVES=true
ZERO_NUCLEI_CVE_LIMIT=100
ZERO_NUCLEI_TARGET_SOURCE="http-services"
ZERO_NUCLEI_PROTOCOL="http"
ZERO_NUCLEI_HEADERS="User-Agent: Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125.0 Safari/537.36|Accept: text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8|Accept-Language: en-US,en;q=0.9"
ZERO_NUCLEI_PROXY=""
ZERO_NUCLEI_SCAN_STRATEGY=""
ZERO_NUCLEI_MAX_HOST_ERROR=0
ZERO_NUCLEI_WAF_DETECT=false
ZERO_NUCLEI_WAF_SAMPLE_SIZE=8
ZERO_NUCLEI_WAF_PROBE_TIMEOUT=5
ZERO_NUCLEI_RATE=80
ZERO_NUCLEI_CONCURRENCY=20
ZERO_NUCLEI_BULK_SIZE=5
ZERO_NUCLEI_TARGET_BATCH_SIZE=500
ZERO_NUCLEI_TARGET_BATCH_TIMEOUT="20m"
# Default/due pipeline program parallelism. Custom campaigns use their own
# campaign parallelism and are not capped by this value.
ZERO_TARGET_PARALLELISM=12
ZERO_SCAN_REQUEST_MAX_ACTIVE=10
ZERO_SCAN_REQUEST_RETRY_ATTEMPTS=4
ZERO_SCAN_REQUEST_RETRY_BASE_DELAY="2m"
ZERO_SCAN_REQUEST_HEARTBEAT="30s"
ZERO_SCAN_REQUEST_STALE_AFTER="30m"
ZERO_DEFAULT_SCAN_INTERVAL_HOURS=72
ZERO_NVD_API_KEY=""
ZERO_TECH_ALIASES_FILE=""
ZERO_CVE_MIN_YEAR=2018
ZERO_NVD_RETRIES=5
ZERO_NVD_RETRY_WAIT="10s"
ZERO_STALE_AFTER_HOURS=72
ZERO_DELETE_INACTIVE_INVENTORY=true
ZERO_INACTIVE_RETENTION_HOURS=0
ZERO_INACTIVE_RETENTION_SCANS=0
ZERO_CHANGE_EVENT_ENTITIES="candidate_finding,nuclei_result"
ZERO_CHANGE_EVENT_RETENTION_HOURS=72
ZERO_SCAN_REQUEST_RETENTION_HOURS=168
ZERO_CLEANUP_BATCH_SIZE=5000

# API and notifications.
ZERO_API_ADDR="127.0.0.1:8080"
ZERO_API_TOKEN=""
ZERO_DASHBOARD_ADDR="127.0.0.1:8090"
ZERO_DASHBOARD_API_BASE_URL="http://127.0.0.1:8080"
ZERO_DASHBOARD_API_TIMEOUT="60s"
ZERO_DISCORD_WEBHOOK_URL=""
ZERO_DISCORD_PASSIVE_WEBHOOK_URL=""
ZERO_DISCORD_VALIDATED_WEBHOOK_URL=""
ZERO_DISCORD_ALERT_WEBHOOK_URL=""
ZERO_RUN_ON_STARTUP=true
ZERO_RECOVER_RUNNING_SCANS=true

# Worker schedules use cron syntax with seconds enabled. The full pipeline is
# the primary continuous execution path: sync scope -> enum -> probe -> nuclei -> report -> notify.
ZERO_SCHEDULE_FULL="0 15 3 */3 * *"
ZERO_SCHEDULE_SCOPE_SYNC="0 15 3 * * *"
ZERO_SCHEDULE_ENUM="0 45 3 * * *"
ZERO_SCHEDULE_PROBE="0 30 4 * * *"
ZERO_SCHEDULE_CVE="0 15 5 * * *"
ZERO_SCHEDULE_NUCLEI="0 45 5 * * *"
ZERO_SCHEDULE_NUCLEI_TEMPLATES="0 5 3 * * *"
ZERO_SCHEDULE_CLEANUP="0 25 */12 * * *"
